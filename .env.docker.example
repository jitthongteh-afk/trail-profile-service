# Example only. Run configure_docker.py to create the real .env.docker file.
DB_AUTH=sql
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=host.docker.internal,1433
DB_DATABASE=Assessment1DB
DB_USERNAME=profile_service_login
DB_PASSWORD=REPLACE_WITH_YOUR_SQL_LOGIN_PASSWORD
DB_ENCRYPT=yes
# Local development with SQL Server's self-signed certificate only.
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECTION_TIMEOUT=5
DB_QUERY_TIMEOUT=10
